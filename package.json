{
  "name": "flowdesk-pro",
  "private": true,
  "version": "0.8.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check": "tsc --noEmit",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "onboarding:screenshots": "node scripts/onboarding-screenshots/capture.mjs",
    "test:onboarding": "node --test src/features/onboarding/registry/registry.test.ts",
    "test:calendar": "node --test src/features/calendar/calendarDates.test.ts",
    "test:recurrence": "node --test src/features/recurrence/recurrenceRules.test.ts",
    "test:onboarding-ui": "node --test scripts/onboarding-screenshots/flows.test.mjs",
    "bundle:macos": "bash scripts/bundle-macos.sh",
    "preview": "vite preview",
    "tauri": "tauri",
    "release": "bash scripts/release.sh"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "lucide-react": "^1.61.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
